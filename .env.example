# --- Warehouse (local dev defaults; see docker-compose.yml) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=marketing_dw
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=postgres

# Runtime roles are created by `make db-init` (least privilege).
# analyst_ro: SELECT on marts only. agent_rw: audit schema. mock_api_rw: mock_ads schema.
ANALYST_RO_PASSWORD=analyst_ro_dev
AGENT_RW_PASSWORD=agent_rw_dev
MOCK_API_RW_PASSWORD=mock_api_dev

# --- Mock marketing API + approval signing ---
MOCK_API_URL=http://localhost:8000
APPROVAL_SECRET=change-me-in-real-life

# --- LLM (optional). Without a key the agent runs in deterministic rule-based mode. ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# MPIA_LLM=off   # force rule-based mode even if a key is set
